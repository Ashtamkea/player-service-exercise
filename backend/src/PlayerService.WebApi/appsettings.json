{
  "Service": {
    "name": "PlayerService"
  },
  "PlayerService": {
    "sessionTtlInSeconds": 300,
    "sessionCleanupIntervalInSeconds": 30,
    "scoreRequestTtlInSeconds": 3600,
    "giftRequestTtlInSeconds": 3600,
    "giftRateLimitWindowInSeconds": 60,
    "giftRateLimitMaxRequests": 50,
    "leaderboardTopSize": 100,
    "leaderboardPollIntervalInSeconds": 180
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
